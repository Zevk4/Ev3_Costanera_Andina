    {
      "id": "b5162qbehl8pjdt1cu7q",
      "type": "text",
      "x": 549.8420448269147,
      "y": 1229.1668580481034,
      "width": 471.75811775672247,
      "height": 104.15098416195714,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
