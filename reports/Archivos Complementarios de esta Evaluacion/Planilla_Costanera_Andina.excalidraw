    {
      "id": "n0wpl9k4nzn3t425l5n8",
      "type": "text",
      "x": 1089.8192397050864,
      "y": 1226.0424467147357,
      "width": 477.1988802362146,
      "height": 83.67042016272181,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
