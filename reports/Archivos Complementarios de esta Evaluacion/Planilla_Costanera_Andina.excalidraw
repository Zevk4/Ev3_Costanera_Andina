      "text": "Monitoreo",
      "originalText": "Monitoreo",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 18,
      "autoResize": true,
