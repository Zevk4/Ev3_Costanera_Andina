      "text": "1. Problema, variable objetivo y riesgo de fuga",
      "originalText": "1. Problema, variable objetivo y riesgo de fuga",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
