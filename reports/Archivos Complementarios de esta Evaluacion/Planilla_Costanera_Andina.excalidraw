    {
      "id": "800ere32yyci6rt5x4bj",
      "type": "text",
      "x": 554,
      "y": 1406,
      "width": 465.9776010954826,
      "height": 101.4609876280195,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1300116933,
      "version": 108,
      "versionNonce": 1211104812,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793906227862,
      "link": null,
      "locked": false,
      "text": "Decisión: Implementar un pipeline reproducible por lotes (batch) para limpieza,\ntransformación y evaluación del clustering. Registrar errores, calidad de datos y resultados\nde cada ejecución.\n\nJustificación: Permite detectar problemas durante el desarrollo y repetir el análisis de\nmanera controlada. El reentrenamiento periódico posterior al cierre queda fuera del\nalcance aprobado.",
      "originalText": "Decisión: Implementar un pipeline reproducible por lotes (batch) para limpieza, transformación y evaluación del clustering. Registrar errores, calidad de datos y resultados de cada ejecución.\n\nJustificación: Permite detectar problemas durante el desarrollo y repetir el análisis de manera controlada. El reentrenamiento periódico posterior al cierre queda fuera del alcance aprobado.",
      "fontSize": 11.595541443202228,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 14,
      "autoResize": false,
