    },
    {
      "id": "thmrlp6srx7h7otlorif",
      "type": "text",
      "x": 14,
      "y": 1224.3159103461705,
      "width": 471.52154132626316,
      "height": 95.29362508382442,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 993687454,
      "version": 152,
      "versionNonce": 2041332012,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793906056578,
      "link": null,
      "locked": false,
      "text": "Decisión: Segmentar clientes mediante aprendizaje no supervisado, utilizando ingresos e índice\nde gasto como variables principales. No existe una variable objetivo, ya que el clustering\nidentifica grupos sin etiquetas previas.\n\nJustificación: El centro comercial carece de perfiles formales de clientes. Se deben excluir\nidentificadores y variables que introduzcan información indebida, evitando sesgos y\nagrupamientos poco representativos.",
      "originalText": "Decisión: Segmentar clientes mediante aprendizaje no supervisado, utilizando ingresos e índice de gasto como variables principales. No existe una variable objetivo, ya que el clustering identifica grupos sin etiquetas previas.\n\nJustificación: El centro comercial carece de perfiles formales de clientes. Se deben excluir identificadores y variables que introduzcan información indebida, evitando sesgos y agrupamientos poco representativos.",
      "fontSize": 10.890700009579934,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 14,
      "autoResize": false,
      "index": "ax",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "e27e7cas8q1fksmplr9b",
      "type": "rectangle",
      "x": 540,
      "y": 1170,
      "width": 500,
      "height": 170,
